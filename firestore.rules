rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Checks if the user is authenticated with Firebase Auth
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Checks if the client uid matches the resource path parameter
    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Validates if the authenticated user is an authorized owner
    function isOwner() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/owners/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/owners/$(request.auth.uid)).data.isOwner == true;
    }
    
    // Validates if the authenticated user is a registered delivery boy
    function isDeliveryBoy() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/deliveryBoys/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/deliveryBoys/$(request.auth.uid)).data.status == "Active" ||
          get(/databases/$(database)/documents/deliveryBoys/$(request.auth.uid)).data.status == "On Delivery"
        );
    }

    // 1. Owners profile documents
    match /owners/{ownerId} {
      allow read: if isSignedIn();
      allow write: if isUser(ownerId);
    }

    // 2. Products collection
    match /products/{productId} {
      allow read: if true; // Publicly browse products
      allow write: if isOwner(); // Only owners can update stock, add, or delete
    }

    // 3. Categories collection
    match /categories/{categoryId} {
      allow read: if true; // Publicly browse categories
      allow write: if isOwner(); // Only owners manage categories
    }

    // 4. Users profiles and nested Orders subcollections
    match /users/{userId} {
      allow read, write: if isUser(userId) || isOwner();
      
      match /orders/{orderId} {
        allow read, write: if isUser(userId) || isOwner();
        allow update: if isDeliveryBoy(); // Active delivery drivers can update status updates on transit
      }
    }

    // 5. Delivery Boys collection & nested Basket subcollections
    match /deliveryBoys/{dboyId} {
      allow read: if isSignedIn();
      allow write: if isOwner(); // Only owners manage driver rosters
      
      match /basket/{orderId} {
        allow read: if isUser(dboyId) || isOwner();
        allow write: if isOwner(); // Only owners assign orders to baskets
        allow delete: if isUser(dboyId) || isOwner(); // Drivers clear items upon delivery completion
      }
    }

    // 6. Refunds logs
    match /refunds/{refundId} {
      allow read, write: if isOwner();
    }

    // 7. Payments transactions logs
    match /payments/{paymentId} {
      allow read, write: if isOwner();
    }

    // 8. Delivery Partner out-of-city logs
    match /delivery_partner_logs/{logId} {
      allow read, write: if isOwner();
    }
  }
}
